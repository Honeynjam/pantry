{
  "name": "pantry",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check": "pnpm check:format && pnpm check:code",
    "check:code": "turbo run typecheck lint test && pnpm test:scripts && pnpm --filter @pantry/web build",
    "check:format": "prettier --check .",
    "fix": "pnpm format && turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "set-version": "node scripts/set-version.mjs",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.9.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3"
  }
}
