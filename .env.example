# apps/web/.env.local (local dev). `convex dev` writes the Convex values for you.

# Convex deployment used by `convex dev` (written automatically, e.g. anonymous:anonymous-pantry)
CONVEX_DEPLOYMENT=

# Convex URLs for the web app (written by `convex dev` into packages/backend/.env.local;
# copy them here, see README)
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
NEXT_PUBLIC_CONVEX_SITE_URL=http://127.0.0.1:3211

# Where the web app runs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to 1 to serve the dev-only /design page from a production build
PANTRY_DESIGN_PAGE=

# Convex deployment env (set with `npx convex env set` on your LOCAL deployment only):
#   SITE_URL=http://localhost:3000
#   BETTER_AUTH_SECRET=$(openssl rand -base64 32)
